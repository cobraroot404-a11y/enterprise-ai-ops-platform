{
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "title": "Enterprise AI Operations Platform (illustrative)",
 "uid": "eaop-overview",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "eaop",
  "illustrative"
 ],
 "description": "Illustrative Grafana dashboard for the platform's /metrics endpoint (one tenant per scrape job). Never imported into a Grafana instance by this project: Grafana is not installed.",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "HTTP request latency p95 by route",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(eaop_http_request_seconds_bucket[5m])))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "HTTP requests per second by status class",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status_class) (rate(eaop_http_request_seconds_count[5m]))",
     "legendFormat": "{{status_class}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Inference duration p95 (language model)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(eaop_llm_seconds_bucket[5m])))",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Retrieval latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(eaop_retrieval_seconds_bucket[5m])))",
     "legendFormat": "retrieval"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Ingestion duration p95",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(eaop_ingestion_seconds_bucket[5m])))",
     "legendFormat": "ingestion"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Workflow completion time p95 (ticket created to submitted)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(eaop_workflow_completion_seconds_bucket[5m])))",
     "legendFormat": "workflow"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Approval turnaround p95",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, decision) (rate(eaop_approval_turnaround_seconds_bucket[5m])))",
     "legendFormat": "{{decision}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "External API calls by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(eaop_connector_calls_total[5m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Retries (submission and ingestion)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(eaop_submission_retries_total[5m])) + sum(rate(eaop_ingestion_retries_total[5m]))",
     "legendFormat": "retries"
    }
   ]
  },
  {
   "id": 10,
   "type": "barchart",
   "title": "Dead letters by source",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (source) (increase(eaop_dead_letters_total[1h]))",
     "legendFormat": "{{source}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Requests refused by rate limits",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (operation) (increase(eaop_api_rate_limited_total[1h]))",
     "legendFormat": "{{operation}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Requests refused by concurrency limits",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (increase(eaop_concurrency_rejected_total[1h]))",
     "legendFormat": "{{reason}}"
    }
   ]
  }
 ]
}
