# Web UI: nginx serving the production build of the React app and proxying /api to the API service.
# The image packages the build produced by `npm run build` on the host (frontend/dist). Building from source inside the image would need a full
# npm dependency download, which was not authorised; run `npm ci && npm run build` in frontend/ first (scripts/container_smoke.py does `npm run build`).
FROM nginx:alpine
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY frontend/dist /usr/share/nginx/html
EXPOSE 80
