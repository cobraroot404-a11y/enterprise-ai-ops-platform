# API, worker, migration/seed tools and the local mock external systems: ONE image, different commands (docker-compose.app.yml).
# Core dependencies only (backend/requirements.txt): no torch, no model weights. The image runs the DETERMINISTIC test-only AI backends;
# real local inference (Ollama, Sentence Transformers) is not part of this image.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
# Versions are constrained by the committed lock file, so a rebuild installs the tested versions (packages the lock file does not name, if any, resolve freely).
COPY backend/requirements.txt backend/requirements.lock.txt backend/
RUN pip install -r backend/requirements.txt -c backend/requirements.lock.txt
COPY backend backend
COPY workers workers
COPY scripts scripts
COPY mock-services mock-services
COPY sample-data sample-data
COPY onboarding onboarding
# No secret is baked in: .env is excluded by .dockerignore and configuration arrives as environment variables at run time.
RUN useradd --system --uid 10001 --create-home eaop && mkdir -p /app/evaluation /app/data && chown -R eaop:eaop /app
USER eaop
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:create_app", "--factory", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000"]
