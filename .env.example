# Copy to .env and change values. Never commit .env.
POSTGRES_USER=eaop
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=eaop
POSTGRES_PORT=5432

# Migrations run as the owner role; the API and worker use restricted roles (RLS enforced).
MIGRATION_DATABASE_URL=postgresql+psycopg://eaop:change-me-local-only@127.0.0.1:5432/eaop
APP_DB_PASSWORD=change-me-app-role
WORKER_DB_PASSWORD=change-me-worker-role
DB_HOST=127.0.0.1

JWT_SECRET=change-me-generate-a-long-random-value
JWT_EXPIRE_MINUTES=30

# AI backends. deterministic = test-only (functional tests/CI); real AI = ollama + sentence_transformers.
# A tenant indexed with one embedding backend is refused by the other until reindexed
# (python scripts/reindex_embeddings.py --tenant <slug> --backend <backend>).
LLM_BACKEND=deterministic
EMBEDDING_BACKEND=deterministic
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Mock ticketing service credential (referenced by connector secret_ref)
MOCK_TICKETING_API_KEY=change-me-mock-ticketing-key
# Meridian's mock service desk: the server key and the connector secret (referenced by NAME in the connector) must match.
MOCK_SERVICEDESK_API_KEY=change-me-mock-servicedesk-key
MERIDIAN_SERVICEDESK_KEY=change-me-mock-servicedesk-key
SEED_PASSWORD=change-me-demo-password

# Outbound connector destinations are controlled by the SERVER, never by tenant admins (docs/security/connector-egress.md).
# EGRESS_ALLOWLIST: production-style allow-list, {"<tenant slug or *>": ["https://origin", ...]}; public addresses only.
# EGRESS_DEV_MOCKS: development-only local mock origins (may resolve to loopback); rejected when EAOP_ENV=production.
EAOP_ENV=development
EGRESS_ALLOWLIST={}
EGRESS_DEV_MOCKS={"apex-industrial":["http://127.0.0.1:8101","http://127.0.0.1:8102"],"apex-uitest":["http://127.0.0.1:8101","http://127.0.0.1:8102"],"meridian-fleet":["http://127.0.0.1:8103","http://127.0.0.1:8104","http://127.0.0.1:8105"],"meridian-uitest":["http://127.0.0.1:8103","http://127.0.0.1:8104","http://127.0.0.1:8105"]}
